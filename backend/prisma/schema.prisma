generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Photographer {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  galleries     Gallery[]
}

model Client {
  id              Int             @id @default(autoincrement())
  email           String          @unique
  transactions    Transaction[]
  unlocked_photos UnlockedPhoto[]
  gallery_accesses GalleryAccess[]
}

model Gallery {
  id                Int           @id @default(autoincrement())
  photographer_id   Int
  photographer      Photographer  @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  name              String
  access_code       String        @unique
  free_limit        Int
  extra_photo_price Decimal
  expires_at        DateTime
  max_clients_allowed Int           @default(0) // 0 significa sin límite
  photos            Photo[]
  transactions      Transaction[]
  accesses          GalleryAccess[]
}

model GalleryAccess {
  id         Int      @id @default(autoincrement())
  gallery_id Int
  gallery    Gallery  @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  client_id  Int
  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([gallery_id, client_id])
}

model Photo {
  id              Int             @id @default(autoincrement())
  gallery_id      Int
  gallery         Gallery         @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  thumbnail_url   String
  high_res_key    String
  folder          String          @default("General")
  unlocked_photos UnlockedPhoto[]
}

model Transaction {
  id               Int             @id @default(autoincrement())
  client_id        Int
  client           Client          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  gallery_id       Int
  gallery          Gallery         @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  mp_preference_id String?
  mp_payment_id    String?
  status           String          // e.g. "pending", "completed"
  total_amount     Decimal
  unlocked_photos  UnlockedPhoto[]
}

model UnlockedPhoto {
  id             Int         @id @default(autoincrement())
  client_id      Int
  client         Client      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  photo_id       Int
  photo          Photo       @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  unlock_method  String      // e.g. "free", "paid"
  transaction_id Int?
  transaction    Transaction? @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@unique([client_id, photo_id])
}
