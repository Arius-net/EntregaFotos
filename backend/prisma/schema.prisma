generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Photographer {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  galleries     Gallery[]
}

model Client {
  id              Int             @id @default(autoincrement())
  name            String?
  email           String          @unique
  password_hash   String?
  otp_code        String?
  otp_expires_at  DateTime?
  transactions    Transaction[]
  unlocked_photos UnlockedPhoto[]
  gallery_accesses GalleryAccess[]
  selected_photos SelectedPhoto[]
  store_orders    StoreOrder[]
}

model Gallery {
  id                Int           @id @default(autoincrement())
  photographer_id   Int
  photographer      Photographer  @relation(fields: [photographer_id], references: [id], onDelete: Cascade)
  name              String
  access_code       String        @unique
  free_limit        Int
  extra_photo_price Decimal
  type              String        @default("FINAL") // "FINAL" o "SELECTION"
  status            String        @default("PENDING") // "PENDING", "SUBMITTED"
  selection_limit   Int           @default(0) // Cuántas fotos puede elegir si es tipo SELECTION
  expires_at        DateTime
  max_clients_allowed Int           @default(0) // 0 significa sin límite
  photos            Photo[]
  transactions      Transaction[]
  accesses          GalleryAccess[]
  selected_photos   SelectedPhoto[]
}

model SelectedPhoto {
  id         Int      @id @default(autoincrement())
  gallery_id Int
  gallery    Gallery  @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  photo_id   Int
  photo      Photo    @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  client_id  Int
  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  
  @@unique([client_id, photo_id])
}

model GalleryAccess {
  id         Int      @id @default(autoincrement())
  gallery_id Int
  gallery    Gallery  @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  client_id  Int
  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([gallery_id, client_id])
}

model Photo {
  id              Int             @id @default(autoincrement())
  gallery_id      Int
  gallery         Gallery         @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  thumbnail_url   String
  high_res_key    String
  is_final        Boolean         @default(false)
  folder          String          @default("General")
  unlocked_photos UnlockedPhoto[]
  selected_photos SelectedPhoto[]
}

model Transaction {
  id               Int             @id @default(autoincrement())
  client_id        Int
  client           Client          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  gallery_id       Int
  gallery          Gallery         @relation(fields: [gallery_id], references: [id], onDelete: Cascade)
  clip_payment_request_id String?
  clip_transaction_id     String?
  status           String          // e.g. "pending", "completed"
  total_amount     Decimal
  unlocked_photos  UnlockedPhoto[]
}

model UnlockedPhoto {
  id             Int         @id @default(autoincrement())
  client_id      Int
  client         Client      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  photo_id       Int
  photo          Photo       @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  unlock_method  String      // e.g. "free", "paid"
  transaction_id Int?
  transaction    Transaction? @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@unique([client_id, photo_id])
}

model LandingSettings {
  id                  Int      @id @default(autoincrement())
  
  // Hero (Carrusel)
  hero_images         String[]
  hero_title          String   @default("Capturando momentos,")
  hero_subtitle       String   @default("contando tu historia.")
  hero_description    String   @default("Especializado en fotografía premium de bodas, eventos y retratos.")
  
  // Sobre Mí
  about_image         String   @default("")
  about_title         String   @default("Hola, soy el rostro detrás de Quevedo Contigo.")
  about_description_1 String   @default("Mi pasión es congelar el tiempo.")
  about_description_2 String   @default("Desde bodas íntimas hasta conciertos vibrantes.")
  
  // Portafolio (Manual)
  portfolio_images    String[]
  
  // Identidad de Marca
  brand_name          String   @default("Quevedo Contigo")
  logo_image          String   @default("")

  // Contacto & Redes
  whatsapp_number     String   @default("521234567890")
  email               String   @default("contacto@quevedocontigo.com")
  instagram_url       String   @default("#")
  facebook_url        String   @default("#")
  location_text       String   @default("México")

  // Legal
  privacy_policy      String   @db.Text @default("")
  terms_conditions    String   @db.Text @default("")

  updated_at          DateTime @updatedAt
}

model StoreItem {
  id              Int      @id @default(autoincrement())
  title           String
  description     String   @db.Text
  price           Decimal
  thumbnail_url   String
  high_res_key    String
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  order_items     StoreOrderItem[]
}

model StoreOrder {
  id              Int      @id @default(autoincrement())
  client_id       Int
  client          Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  status          String   @default("PENDING") // PENDING, PAID, CANCELLED
  total_amount    Decimal
  payment_method  String?  // OPENPAY, STRIPE, WHATSAPP
  payment_id      String?  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  items           StoreOrderItem[]
}

model StoreOrderItem {
  id              Int      @id @default(autoincrement())
  order_id        Int
  order           StoreOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  store_item_id   Int
  store_item      StoreItem  @relation(fields: [store_item_id], references: [id])
  price_at_time   Decimal
  quantity        Int
}
